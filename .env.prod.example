# Runtime profile
SPRING_PROFILES_ACTIVE=prod

# External service ports or platform-provided ports
GATEWAY_SERVICE_PORT=8080
IDENTITY_SERVICE_PORT=8081
EVENT_MANAGEMENT_SERVICE_PORT=8082
SEATING_INVENTORY_SERVICE_PORT=8083
ORDERS_SERVICE_PORT=8084
PAYMENTS_SERVICE_PORT=8085
TICKET_ISSUANCE_SERVICE_PORT=8086
ACCESS_CONTROL_SERVICE_PORT=8087
NOTIFICATIONS_SERVICE_PORT=8088
REPORTING_SERVICE_PORT=8089

# RabbitMQ production endpoint
RABBITMQ_HOST=your-rabbitmq-host
RABBITMQ_PORT=5672
RABBITMQ_USER=your-rabbitmq-user
RABBITMQ_PASSWORD=your-rabbitmq-password

# Current fallback until ADR-018 is implemented end to end.
JWT_SECRET=replace-with-secret-manager-value

# ADR-018 target JWT/JWKS configuration.
JWT_ISSUER=https://identity.your-domain.example
JWT_KEY_ID=prod-key-1
JWT_PRIVATE_KEY=replace-with-secret-manager-value
JWT_PUBLIC_KEY=replace-with-secret-manager-value
JWT_EXPIRATION=3600000
IDENTITY_JWKS_URI=https://identity.your-domain.example/.well-known/jwks.json

STRIPE_API_KEY=replace-with-secret-manager-value
STRIPE_WEBHOOK_SECRET=replace-with-secret-manager-value

# ADR-019 target email delivery configuration.
RESEND_API_KEY=replace-with-secret-manager-value
RESEND_FROM_EMAIL=tickets@your-domain.example
RESEND_FROM_NAME=OrionTicket
NOTIFICATIONS_EMAIL_ENABLED=true
ORIONTICKET_PUBLIC_BASE_URL=https://your-domain.example

# ADR-020 target observability configuration.
OBSERVABILITY_ENABLED=true
OTEL_SERVICE_NAME=orionticket-service-name
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod.example.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic replace-with-grafana-cloud-token
GRAFANA_CLOUD_PROMETHEUS_REMOTE_WRITE_URL=https://prometheus-prod.example.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USERNAME=replace-with-instance-id
GRAFANA_CLOUD_API_KEY=replace-with-secret-manager-value
GRAFANA_CLOUD_LOKI_URL=https://logs-prod.example.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_TEMPO_OTLP_ENDPOINT=https://tempo-prod.example.grafana.net/otlp

# Cloud PostgreSQL - Identity Service
IDENTITY_DB_HOST=your-prod-identity-db-host
IDENTITY_DB_PORT=5432
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=replace-with-secret-manager-value

# Cloud PostgreSQL - Event Management Service
EVENT_MANAGEMENT_DB_HOST=your-prod-event-management-db-host
EVENT_MANAGEMENT_DB_PORT=5432
EVENT_MANAGEMENT_DB_NAME=event_management_db
EVENT_MANAGEMENT_DB_USER=event_management_user
EVENT_MANAGEMENT_DB_PASSWORD=replace-with-secret-manager-value

SEATING_INVENTORY_DB_HOST=your-prod-seating-inventory-db-host
SEATING_INVENTORY_DB_PORT=5432
SEATING_INVENTORY_DB_NAME=seating_inventory_db
SEATING_INVENTORY_DB_USER=seating_inventory_user
SEATING_INVENTORY_DB_PASSWORD=replace-with-secret-manager-value

ORDERS_DB_HOST=your-prod-orders-db-host
ORDERS_DB_PORT=5432
ORDERS_DB_NAME=orders_db
ORDERS_DB_USER=orders_user
ORDERS_DB_PASSWORD=replace-with-secret-manager-value

PAYMENTS_DB_HOST=your-prod-payments-db-host
PAYMENTS_DB_PORT=5432
PAYMENTS_DB_NAME=payments_db
PAYMENTS_DB_USER=payments_user
PAYMENTS_DB_PASSWORD=replace-with-secret-manager-value

TICKET_ISSUANCE_DB_HOST=your-prod-ticket-issuance-db-host
TICKET_ISSUANCE_DB_PORT=5432
TICKET_ISSUANCE_DB_NAME=ticket_issuance_db
TICKET_ISSUANCE_DB_USER=ticket_issuance_user
TICKET_ISSUANCE_DB_PASSWORD=replace-with-secret-manager-value

ACCESS_CONTROL_DB_HOST=your-prod-access-control-db-host
ACCESS_CONTROL_DB_PORT=5432
ACCESS_CONTROL_DB_NAME=access_control_db
ACCESS_CONTROL_DB_USER=access_control_user
ACCESS_CONTROL_DB_PASSWORD=replace-with-secret-manager-value

NOTIFICATIONS_DB_HOST=your-prod-notifications-db-host
NOTIFICATIONS_DB_PORT=5432
NOTIFICATIONS_DB_NAME=notifications_db
NOTIFICATIONS_DB_USER=notifications_user
NOTIFICATIONS_DB_PASSWORD=replace-with-secret-manager-value

REPORTING_DB_HOST=your-prod-reporting-db-host
REPORTING_DB_PORT=5432
REPORTING_DB_NAME=reporting_db
REPORTING_DB_USER=reporting_user
REPORTING_DB_PASSWORD=replace-with-secret-manager-value

# Gateway upstreams in the production network
IDENTITY_SERVICE_URL=http://identity-service:8081
EVENT_MANAGEMENT_SERVICE_URL=http://event-management-service:8082
SEATING_INVENTORY_SERVICE_URL=http://seating-inventory-service:8083
ORDERS_SERVICE_URL=http://orders-service:8084
PAYMENTS_SERVICE_URL=http://payments-service:8085
TICKET_ISSUANCE_SERVICE_URL=http://ticket-issuance-service:8086
ACCESS_CONTROL_SERVICE_URL=http://access-control-service:8087
NOTIFICATIONS_SERVICE_URL=http://notifications-service:8088
REPORTING_SERVICE_URL=http://reporting-service:8089
