# compose.prod.yml
# Production stack: 9 microservices + RabbitMQ.
# PostgreSQL is external through HAProxy at ${IP_NUBE}:5000.

SPRING_PROFILES_ACTIVE=prod

IP_NUBE=100.64.0.10
GLOBAL_DB_USER=app_user
GLOBAL_DB_PASSWORD=replace-with-db-password
GLOBAL_DB_NAME=orionticketdb

# RabbitMQ container credentials for production.
RABBITMQ_USER=replace-with-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-rabbitmq-password

# ADR-018 JWT/JWKS configuration. Use escaped newlines in PEM values.
JWT_ISSUER=https://identity.your-domain.example
JWT_KEY_ID=prod-key-1
JWT_PRIVATE_KEY=replace-with-private-key-pem-escaped-newlines
JWT_PUBLIC_KEY=replace-with-public-key-pem-escaped-newlines
JWT_EXPIRATION=86400
IDENTITY_JWKS_URI=https://identity.your-domain.example/.well-known/jwks.json

# Payment provider credentials.
STRIPE_API_KEY=replace-with-stripe-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret

# Email provider credentials.
RESEND_API_KEY=replace-with-resend-key
RESEND_FROM_EMAIL=tickets@your-domain.example
RESEND_FROM_NAME=OrionTicket
NOTIFICATIONS_EMAIL_ENABLED=true
ORIONTICKET_PUBLIC_BASE_URL=https://your-domain.example

# Kept disabled until observability infrastructure is wired.
OBSERVABILITY_ENABLED=false
