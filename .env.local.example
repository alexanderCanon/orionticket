# compose.local.yml
# Initial VPS/lab stack: 7 essential microservices + RabbitMQ.
# PostgreSQL is external through HAProxy at ${GLOBAL_DB_HOST}:5000.
# The external API Gateway reaches these services over Tailscale.

SPRING_PROFILES_ACTIVE=lab

# RAM Limit per microservice container (optimized for 4GB VPS)
SERVICE_MEM_LIMIT=
API_DOCS_ENABLED=false
GLOBAL_DB_HOST=
GLOBAL_DB_USER=app_user
GLOBAL_DB_PASSWORD=replace-with-db-password
GLOBAL_DB_NAME=

# RabbitMQ container credentials for this VPS/lab stack.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ADR-018 JWT/JWKS configuration. Use escaped newlines in PEM values.
JWT_ISSUER=orionticket-identity
JWT_KEY_ID=lab-key-1
JWT_PRIVATE_KEY=replace-with-private-key-pem
JWT_PUBLIC_KEY=replace-with-public-key-pem
JWT_EXPIRATION=
IDENTITY_JWKS_URI=http://identity-service:8081/.well-known/jwks.json

# Payment provider placeholders used by payments-service.
STRIPE_API_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Email provider placeholders used by notifications-service.
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
NOTIFICATIONS_EMAIL_ENABLED=true
ORIONTICKET_PUBLIC_BASE_URL=

# Observability / Grafana Cloud
OBSERVABILITY_ENABLED=false
GRAFANA_CLOUD_PROMETHEUS_REMOTE_WRITE_URL=https://prometheus-prod.example.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USERNAME=replace-with-instance-id
GRAFANA_CLOUD_API_KEY=replace-with-token
GRAFANA_CLOUD_TEMPO_OTLP_ENDPOINT=https://tempo-prod.example.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic replace-with-grafana-cloud-token
