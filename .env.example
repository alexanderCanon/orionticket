# compose.yml
# Local stack: 7 essential microservices + PostgreSQL + RabbitMQ.

SPRING_PROFILES_ACTIVE=local

# Local PostgreSQL container credentials.
GLOBAL_DB_USER=app_user
GLOBAL_DB_PASSWORD=AppSecret789
GLOBAL_DB_NAME=orionticketdb

# Current fallback until ADR-018 is implemented end to end.
JWT_SECRET=replace-with-local-shared-jwt-secret

# Payment provider placeholders used by payments-service.
STRIPE_API_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Email provider placeholders used by notifications-service.
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=tickets@orionticket.local
RESEND_FROM_NAME=OrionTicket
NOTIFICATIONS_EMAIL_ENABLED=true
ORIONTICKET_PUBLIC_BASE_URL=http://localhost:4200
