# Copy this file to .env for local development.
# Use .env.local.example for the shared local network setup.
# Use .env.prod.example as the production reference.

SPRING_PROFILES_ACTIVE=local

GATEWAY_SERVICE_PORT=8080
IDENTITY_SERVICE_PORT=8081
EVENT_MANAGEMENT_SERVICE_PORT=8082
SEATING_INVENTORY_SERVICE_PORT=8083
ORDERS_SERVICE_PORT=8084
PAYMENTS_SERVICE_PORT=8085
TICKET_ISSUANCE_SERVICE_PORT=8086
ACCESS_CONTROL_SERVICE_PORT=8087
NOTIFICATIONS_SERVICE_PORT=8088
REPORTING_SERVICE_PORT=8089
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Current local fallback until ADR-018 is implemented end to end.
JWT_SECRET=replace-with-local-shared-jwt-secret

# ADR-018 target JWT/JWKS configuration.
JWT_ISSUER=http://identity-service:8081
JWT_KEY_ID=local-dev-key-1
JWT_PRIVATE_KEY=replace-with-private-key-pem
JWT_PUBLIC_KEY=replace-with-public-key-pem
JWT_EXPIRATION=86400000
IDENTITY_JWKS_URI=http://identity-service:8081/.well-known/jwks.json

STRIPE_API_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ADR-019 target email delivery configuration.
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=tickets@orionticket.local
RESEND_FROM_NAME=OrionTicket
NOTIFICATIONS_EMAIL_ENABLED=true
ORIONTICKET_PUBLIC_BASE_URL=http://localhost:4200

# ADR-020 target observability configuration.
OBSERVABILITY_ENABLED=false
OTEL_SERVICE_NAME=orionticket-service-name
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod.example.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic replace-with-grafana-cloud-token
GRAFANA_CLOUD_PROMETHEUS_REMOTE_WRITE_URL=https://prometheus-prod.example.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USERNAME=replace-with-instance-id
GRAFANA_CLOUD_API_KEY=replace-with-token
GRAFANA_CLOUD_LOKI_URL=https://logs-prod.example.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_TEMPO_OTLP_ENDPOINT=https://tempo-prod.example.grafana.net/otlp

IDENTITY_DB_HOST=your-identity-db-host
IDENTITY_DB_PORT=5432
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=identity_password

EVENT_MANAGEMENT_DB_HOST=your-event-management-db-host
EVENT_MANAGEMENT_DB_PORT=5432
EVENT_MANAGEMENT_DB_NAME=event_management_db
EVENT_MANAGEMENT_DB_USER=event_management_user
EVENT_MANAGEMENT_DB_PASSWORD=event_management_password

SEATING_INVENTORY_DB_HOST=your-seating-inventory-db-host
SEATING_INVENTORY_DB_PORT=5432
SEATING_INVENTORY_DB_NAME=seating_inventory_db
SEATING_INVENTORY_DB_USER=seating_inventory_user
SEATING_INVENTORY_DB_PASSWORD=seating_inventory_password

ORDERS_DB_HOST=your-orders-db-host
ORDERS_DB_PORT=5432
ORDERS_DB_NAME=orders_db
ORDERS_DB_USER=orders_user
ORDERS_DB_PASSWORD=orders_password

PAYMENTS_DB_HOST=your-payments-db-host
PAYMENTS_DB_PORT=5432
PAYMENTS_DB_NAME=payments_db
PAYMENTS_DB_USER=payments_user
PAYMENTS_DB_PASSWORD=payments_password

TICKET_ISSUANCE_DB_HOST=your-ticket-issuance-db-host
TICKET_ISSUANCE_DB_PORT=5432
TICKET_ISSUANCE_DB_NAME=ticket_issuance_db
TICKET_ISSUANCE_DB_USER=ticket_issuance_user
TICKET_ISSUANCE_DB_PASSWORD=ticket_issuance_password

ACCESS_CONTROL_DB_HOST=your-access-control-db-host
ACCESS_CONTROL_DB_PORT=5432
ACCESS_CONTROL_DB_NAME=access_control_db
ACCESS_CONTROL_DB_USER=access_control_user
ACCESS_CONTROL_DB_PASSWORD=access_control_password

NOTIFICATIONS_DB_HOST=your-notifications-db-host
NOTIFICATIONS_DB_PORT=5432
NOTIFICATIONS_DB_NAME=notifications_db
NOTIFICATIONS_DB_USER=notifications_user
NOTIFICATIONS_DB_PASSWORD=notifications_password

REPORTING_DB_HOST=your-reporting-db-host
REPORTING_DB_PORT=5432
REPORTING_DB_NAME=reporting_db
REPORTING_DB_USER=reporting_user
REPORTING_DB_PASSWORD=reporting_password

IDENTITY_SERVICE_URL=http://localhost:8081
EVENT_MANAGEMENT_SERVICE_URL=http://localhost:8082
SEATING_INVENTORY_SERVICE_URL=http://localhost:8083
ORDERS_SERVICE_URL=http://localhost:8084
PAYMENTS_SERVICE_URL=http://localhost:8085
TICKET_ISSUANCE_SERVICE_URL=http://localhost:8086
ACCESS_CONTROL_SERVICE_URL=http://localhost:8087
NOTIFICATIONS_SERVICE_URL=http://localhost:8088
REPORTING_SERVICE_URL=http://localhost:8089
